// Huddle database schema. Full target design: docs/schema.prisma (lands in #4).
//
// Convention: no Postgres enums. Columns that hold a fixed set of values are
// plain strings; the allowed values live in @huddle/shared and are validated
// with zod at the API boundary, so changing them never needs a migration.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique @db.VarChar(50)
  firstname String   @db.VarChar(50)
  lastname  String   @db.VarChar(50)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  /// AppRole from @huddle/shared: ADMIN | STANDARD
  role      String   @default("STANDARD") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([username])
}
