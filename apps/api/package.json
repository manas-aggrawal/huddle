{
	"name": "@huddle/api",
	"version": "0.1.0",
	"description": "Huddle backend (NestJS)",
	"author": "Manas Aggrawal",
	"private": true,
	"scripts": {
		"prebuild": "rimraf dist",
		"container:init": "docker compose up",
		"container:run": "docker exec -it huddle-api /bin/sh",
		"container:run:bash": "docker exec -it huddle-api /bin/bash",
		"container:rebuild": "docker compose down && docker compose build api && docker compose up",
		"container:db:init": "docker exec -it huddle-api npm run db:init",
		"db:init": "npm run migrate && npm run seed",
		"seed": "ts-node prisma/scripts/seed.ts",
		"migrate": "npx prisma migrate deploy",
		"migrate:new": "npx prisma migrate dev",
		"build": "nest build",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"postinstall": "prisma generate",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
		"openapi:export": "nest build && node dist/scripts/export-openapi.js dist/openapi.json"
	},
	"dependencies": {
		"@ai-sdk/groq": "^4.0.59",
		"@ai-sdk/openai-compatible": "^3.0.67",
		"@hocuspocus/extension-database": "^4.7.0",
		"@hocuspocus/server": "^4.7.0",
		"@huddle/shared": "*",
		"@nestjs/common": "^11.1.9",
		"@nestjs/core": "^11.1.9",
		"@nestjs/jwt": "^11.0.1",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.1.9",
		"@nestjs/platform-socket.io": "^11.2.7",
		"@nestjs/swagger": "^11.2.1",
		"@nestjs/terminus": "^11.0.0",
		"@nestjs/throttler": "^6.5.0",
		"@nestjs/websockets": "^11.2.7",
		"@prisma/client": "^6.19.0",
		"ai": "^7.0.136",
		"bcryptjs": "^2.4.3",
		"dotenv": "^16.0.3",
		"helmet": "^8.1.0",
		"joi": "^17.8.3",
		"nest-winston": "^1.10.2",
		"nestjs-zod": "^5.0.1",
		"passport": "^0.6.0",
		"passport-jwt": "^4.0.1",
		"passport-local": "^1.0.0",
		"reflect-metadata": "^0.1.13",
		"rimraf": "^3.0.2",
		"rxjs": "^7.2.0",
		"winston": "^3.17.0",
		"ws": "^8.22.0",
		"yjs": "^13.6.33",
		"zod": "^4.1.0"
	},
	"devDependencies": {
		"@hocuspocus/provider": "^4.7.0",
		"@nestjs/cli": "^11.0.10",
		"@nestjs/schematics": "^11.0.9",
		"@nestjs/testing": "^11.1.9",
		"@swc/core": "^1.13.5",
		"@types/bcryptjs": "^2.4.6",
		"@types/express": "^5.0.3",
		"@types/node": "^22.13.0",
		"@types/supertest": "^6.0.3",
		"@types/ws": "^8.18.2",
		"openapi-typescript": "^7.13.0",
		"prisma": "^6.19.0",
		"socket.io-client": "^4.8.4",
		"source-map-support": "^0.5.20",
		"supertest": "^7.1.4",
		"ts-node": "^10.0.0",
		"tsconfig-paths": "4.1.0",
		"typescript": "^5.9.3",
		"unplugin-swc": "^1.5.7",
		"vitest": "^4.1.11"
	}
}
