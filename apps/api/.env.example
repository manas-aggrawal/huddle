# Config
PORT=3001
PORT_DATABASE=5432

# Postgres
PG_USER="postgres"
PG_PASSWORD="postgres"
PG_DATABASE_NAME="huddle"

# JWT 
JWT_ACCESS_TOKEN_SECRET="abc"
JWT_REFRESH_TOKEN_SECRET="cba"
JWT_FORGOT_PASSWORD_SECRET="def"
# Token lifetimes ("30s", "15m", "1h"). Set ACCESS_TOKEN_TTL=30s to watch the web app refresh silently.
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=8h

# Used when the API runs on your machine (npm run dev). docker-compose overrides it for the api container.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/huddle?schema=public"

# Rate limiting (ThrottlerModule)
THROTTLE_TTL=60000    # Time window in milliseconds
THROTTLE_LIMIT=100    # Max requests per window for general routes

# CORS — comma-separated list of allowed origins
# Leave unset to disable CORS entirely (e.g. for internal/private APIs)
ALLOWED_ORIGINS=http://localhost:5173

# Model a new session uses when the creator doesn't pick one
DEFAULT_MODEL_PROVIDER=groq
DEFAULT_MODEL_ID=llama-3.3-70b-versatile
# Other models people can pick, "provider:modelId" comma-separated
# MODELS=ollama:qwen2.5:14b

# Groq: free API key from https://console.groq.com/keys
GROQ_API_KEY=
# Ollama (local models): where `ollama serve` listens
OLLAMA_BASE_URL=http://localhost:11434

# Where the web app runs; invite links point here
WEB_APP_URL=http://localhost:5173
